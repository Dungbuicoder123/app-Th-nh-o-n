rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function inUnit(unit) {
      return request.auth != null && (profile().unitCode == unit ||
        (profile().role == 'ward_officer' &&
          firestore.get(/databases/(default)/documents/registeredUnits/$(unit)).data.get('parentUnitCode', '') == profile().unitCode));
    }
    match /newsAttachments/{unit}/{article}/{file} {
      allow read: if inUnit(unit);
      allow delete: if request.auth != null && profile().unitCode == unit && profile().role in ['bi_thu', 'ward_officer']
        && !firestore.exists(/databases/(default)/documents/unitWork/$(unit)/events/$(article));
      allow create: if inUnit(unit) && profile().role in ['bi_thu', 'ward_officer']
        && article.matches('[a-f0-9]{24}') && file.matches('[a-f0-9-]{36}')
        && request.resource != null && request.resource.size > 0
        && ((request.resource.contentType in ['video/mp4','video/webm'] && request.resource.size <= 50 * 1024 * 1024)
          || (request.resource.contentType in ['image/jpeg','image/png','image/webp','application/pdf','text/plain',
            'application/msword','application/vnd.ms-excel',
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet']
            && request.resource.size <= 20 * 1024 * 1024));
    }
  }
}
